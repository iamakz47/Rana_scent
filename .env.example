# Copy to .env.local and fill in. Never commit real values.
# Supabase dashboard -> Project Settings -> API.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Optional: public origin for canonical URLs, e.g. https://ranascent.com.
# Defaults to the Vercel production domain on Vercel, localhost otherwise.
NEXT_PUBLIC_SITE_URL=

# Set to "true" at launch to let search engines index the site.
SITE_INDEXING=

# Server only (never NEXT_PUBLIC_). Supabase secret key (sb_secret_...).
# Needed for staff invitations, payments, emails and customer accounts.
SUPABASE_SECRET_KEY=

# Storefront data: unset/"sample" = Phase 1 preview catalog; "supabase" =
# published products, categories, slides and settings from the database.
# Switch only after the Phase 2 migrations are applied (docs/phase-2-database.md).
CATALOG_SOURCE=

# Payments (server only). PAYMENTS_PROVIDER=tap with a Tap test key first.
# See docs/phase-3-commerce.md. Live keys need TAP_LIVE_ENABLED=true.
PAYMENTS_PROVIDER=
TAP_SECRET_KEY=
TAP_LIVE_ENABLED=
TAP_SOURCE_ID=

# Emails via Resend (server only). Without RESEND_API_KEY + EMAIL_FROM the
# safe test adapter records emails without sending them.
RESEND_API_KEY=
# e.g. "Rana Scent <orders@your-verified-domain>" (ORDER_EMAIL_FROM also works).
EMAIL_FROM=
EMAIL_REPLY_TO=
# Outside the production deployment, real sending is limited to these
# addresses or "@domain" entries (comma-separated). Empty = nobody.
EMAIL_TEST_ALLOWLIST=
# "test" forces the test adapter anywhere.
EMAIL_PROVIDER=

# Protects /api/cron/reconcile (Vercel Cron sends it) and /api/revalidate.
# At least 16 random characters. Without it both endpoints refuse requests.
CRON_SECRET=
